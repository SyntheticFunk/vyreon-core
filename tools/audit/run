#!/usr/bin/env bash
# One read-only Codex audit of one subsystem. Usage: tools/audit/run SCOPE REPO OUT_DIR [NOTE_FILE]
#   SCOPE     a file name under tools/audit/scopes (overlay, surface, core, tape, ...) or a path to a scope file
#             (NAME.md, kept outside OUT_DIR: the report is written to OUT_DIR/NAME.md)
#   REPO      the checkout to audit (the candidate branch's worktree)
#   OUT_DIR   where the report goes (OUT_DIR/SCOPE.md); the brief sent and Codex's log are kept beside it
#   Model: gpt-6.2-astra (owner, 2026-11-17); VYREON_AUDIT_MODEL overrides it. Reasoning effort comes from
#   ~/.codex/config.toml.
#   NOTE_FILE optional text appended to the brief (what earlier audits found, which commits claim to fix them)
# Codex only reads (-s read-only). Its findings are claims: verify each with briefs/triage.md before fixing.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
scope=${1:?scope}; repo=${2:?repo}; out=${3:?output directory}; note=${4:-}
file=$scope; [ -f "$file" ] || file="$here/scopes/$scope.md"
name=$(basename "$file" .md); mkdir -p "$out"
{ cat "$here/briefs/audit-common.md"; echo; cat "$file"; if [ -n "$note" ]; then echo; cat "$note"; fi; } > "$out/$name.brief.md"
echo "candidate: $(git -C "$repo" rev-parse --short=8 HEAD) $(git -C "$repo" branch --show-current)" > "$out/$name.log"
# Audit a clean checkout of the commit (tracked files only): the live folder holds git-ignored secret files
# (api.txt, tokens, keys) that a reviewer must never read (2026-11-23).
clean=$(mktemp -d "${TMPDIR:-/tmp}/audit-clean.XXXXXX"); rmdir "$clean"
git -C "$repo" worktree add --detach "$clean" HEAD >/dev/null 2>&1
trap 'git -C "$repo" worktree remove --force "$clean" >/dev/null 2>&1 || true' EXIT
codex exec -m "${VYREON_AUDIT_MODEL:-gpt-6.2-astra}" -s read-only -C "$clean" -o "$out/$name.md" - < "$out/$name.brief.md" >> "$out/$name.log" 2>&1
echo "$name: $(wc -l < "$out/$name.md") lines in $out/$name.md"
# Codex's allowance after this audit, from its newest session log (the owner asked to see it, 2026-11-16)
f=$(ls -t ~/.codex/sessions/*/*/*/*.jsonl 2>/dev/null | head -1)
[ -n "$f" ] && grep -o '"primary":{"used_percent":[0-9.]*,"window_minutes":[0-9]*,"resets_at":[0-9]*' "$f" | tail -1 | python3 -c "
import sys,re,datetime
m=re.search(r'used_percent\":([0-9.]+),\"window_minutes\":([0-9]+),\"resets_at\":([0-9]+)',sys.stdin.read())
if m: print('codex allowance: %s%% of the %s-day window used; resets %s UTC' % (m.group(1), int(m.group(2))//1440, datetime.datetime.utcfromtimestamp(int(m.group(3))).strftime('%Y-%m-%d %H:%M')))" || true
