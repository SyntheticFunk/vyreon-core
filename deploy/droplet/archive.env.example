# /etc/vyreon-archive.env (mode 600): settings of the nightly archive of captured inputs.
VYREON_ARCHIVE_DIR=/mnt/vyreon_engine_v1/archive
# optional: the captures copied off the laptop (archived once)
VYREON_ARCHIVE_LAPTOP_DIR=/mnt/vyreon_engine_v1/laptop-perishables
VYREON_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
VYREON_SPACES_BUCKET=
# Files holding the Spaces access key id and secret (mode 600; never printed or committed).
VYREON_SPACES_KEY_ID_FILE=/etc/vyreon/spaces-key-id
VYREON_SPACES_SECRET_FILE=/etc/vyreon/spaces-secret
